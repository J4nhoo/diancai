{
  "envId": "meal-order-xxxxxxxxxxxxxxxxx",
  "region": "ap-singapore",
  "functionRoot": "deploy/cloudfunction",
  "functions": [
    {
      "name": "meal-order-api",
      "type": "HTTP",
      "runtime": "Nodejs18.15",
      "timeout": 60,
      "memorySize": 512,
      "installDependency": false,
      "envVariables": {
        "NODE_ENV": "production",
        "PORT": "9000",
        "TRUST_PROXY": "1",
        "AUTO_INIT_DB": "true",
        "DB_HOST": "<Aiven Host>",
        "DB_PORT": "<Aiven Port>",
        "DB_USER": "avnadmin",
        "DB_PASSWORD": "<Aiven Password>",
        "DB_NAME": "defaultdb",
        "DB_SSL": "true",
        "JWT_SECRET": "<随机长串>",
        "STORAGE_DRIVER": "cos",
        "MAX_UPLOAD_MB": "8",
        "COS_SECRET_ID": "<腾讯云 SecretId>",
        "COS_SECRET_KEY": "<腾讯云 SecretKey>",
        "COS_BUCKET": "meal-images-1250000000",
        "COS_REGION": "ap-guangzhou",
        "ADMIN_USERNAME": "admin",
        "ADMIN_PASSWORD": "<你自己定的登录密码>",
        "ADMIN_DISPLAY_NAME": "管理员"
      }
    }
  ]
}
