# ---- 服务 ----
PORT=3000
NODE_ENV=production
# 信任的代理跳数。Render 前面只有一层代理，填 1；
# 不要填 true —— 那会信任整条 X-Forwarded-For 链，req.ip 可被客户端伪造，
# 从而绕过登录限流（暴力破解防护会失效）。直连（无代理）时填 false。
TRUST_PROXY=1
# 允许跨域的前端地址，多个用英文逗号分隔；同源部署留空即可
CORS_ORIGINS=

# ---- 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=meal_order
DB_PASSWORD=请改成强密码
DB_NAME=meal_order
DB_CONNECTION_LIMIT=10
# 托管数据库（Aiven 等）强制 TLS，必须填 true
DB_SSL=false
# 证书校验。Aiven 的证书是受信任 CA 签发的，保持 true 即可
DB_SSL_REJECT_UNAUTHORIZED=true

# ---- 鉴权 ----
# 必须改成随机长字符串：node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=请改成随机长字符串
JWT_EXPIRES_IN=7d

# ---- 数据库自动初始化 ----
# true：服务启动时自动建表 + 建种子分组 + 建首个管理员（幂等，已存在会跳过）。
# 托管平台（如 Render 免费档）没有 Shell，打开它就不用手工跑 npm run init-db。
# 失败只记日志、不阻断启动。本地开发和自建 VPS 保持 false 即可。
AUTO_INIT_DB=false

# ---- 图片存储 ----
# local：存服务器磁盘（本地开发用；Render 免费档磁盘是临时的，图片会丢）
# cos  ：存腾讯云 COS 对象存储（推荐，国内访问快）
# r2   ：存 Cloudflare R2（需要绑卡才能开通）
STORAGE_DRIVER=local
MAX_UPLOAD_MB=8

# 仅 STORAGE_DRIVER=local 时生效
IMAGE_DIR=./uploads
# 图片对外访问前缀，需与 Nginx location 保持一致
IMAGE_URL_PREFIX=/uploads

# 仅 STORAGE_DRIVER=cos 时生效（四项都必填）
# 腾讯云控制台 → 访问管理 → API 密钥管理，拿 SecretId / SecretKey
COS_SECRET_ID=
COS_SECRET_KEY=
# 桶名必须带 APPID 后缀，形如 meal-images-1250000000
COS_BUCKET=
# 地域，形如 ap-guangzhou / ap-shanghai
COS_REGION=ap-guangzhou
# 可选：绑定 CDN 加速域名后填这里（末尾不带斜杠）。
# 留空则用默认域名 https://<bucket>.cos.<region>.myqcloud.com
COS_PUBLIC_BASE_URL=

# 仅 STORAGE_DRIVER=r2 时生效（五项都必填）
# Cloudflare 控制台 → R2 → API 令牌，创建「对象读写」权限的令牌
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=meal-images
# 桶的公网访问地址，形如 https://pub-xxxxxxxx.r2.dev 或绑定的自定义域名，末尾不带斜杠
R2_PUBLIC_BASE_URL=

# ---- 初始化管理员（仅 init-db 使用）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成强密码
ADMIN_DISPLAY_NAME=管理员
